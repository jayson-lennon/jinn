stream_rules.toml
# jinn never reads a repo-local config tree; shipped defaults live in res/
# and install into the user's config directory. Ignore the whole subtree so
# a local .config can never be tracked again.
.config/*
worktrees/*
.jinn-autocoder-trash/*
.issues/*
.autodev.ledger.md
# Askama templates are source, not build output: the webui slice's page
# and fragment templates compile into the binary and must be tracked
# (the `*.html` rule above ate the four model templates once — fresh
# checkouts could not compile).
!crates/slices/jinn-webui/templates/*.html
*.wav
.artifacts
/*.toml
/*.html
/*.png
/*.md
!clippy.toml
!Cargo.toml
dump/
dumps/
__pycache__/
*.pyc

# webui e2e tier run artifacts (webui/client/e2e)
