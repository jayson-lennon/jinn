# jinn never reads a repo-local config tree; shipped defaults live in res/
# and install into the user's config directory. Ignore the whole subtree so
# a local .config can never be tracked again.
.config/*
worktrees/*
.jinn-autocoder-trash/*
.issues/*
.autodev.ledger.md
*.wav
.artifacts
/*.toml
/*.html
/*.png
/*.md
!clippy.toml
!Cargo.toml
dump/
dumps/
__pycache__/
*.pyc

# Installed Node dependencies, anywhere in the tree. A directory that
# deletes its own nested .gitignore while leaving node_modules/ on disk
# flips that folder from ignored to untracked, and `just commit` sweeps it in.
node_modules/

# webui2 client (the web UI, /web2): its build output is produced by the
# jinn-webui2 slice's build.rs on every cargo compile; nothing of the bundle
# is committed.
webui/client2/dist/
webui/client2/e2e/playwright-report/
webui/client2/e2e/test-results/

# Playwright's run-status output from a suite run at the repo root.
test-results/
